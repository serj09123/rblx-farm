--!strict
-- Runtime argument validation for anything that crosses the network boundary.
-- Every check returns (ok, reason?). Never trust client values.

export type Check = (value: any) -> (boolean, string?)

local Guard = {}

local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function Guard.number(min: number, max: number): Check
	return function(value)
		if not isFiniteNumber(value) then
			return false, "expected finite number"
		end
		if value < min or value > max then
			return false, "number out of range"
		end
		return true
	end
end

function Guard.integer(min: number, max: number): Check
	return function(value)
		if not isFiniteNumber(value) or value % 1 ~= 0 then
			return false, "expected integer"
		end
		if value < min or value > max then
			return false, "integer out of range"
		end
		return true
	end
end

function Guard.string(maxLength: number, pattern: string?): Check
	return function(value)
		if type(value) ~= "string" then
			return false, "expected string"
		end
		if #value == 0 or #value > maxLength then
			return false, "string length out of range"
		end
		if pattern and not string.match(value, pattern) then
			return false, "string format invalid"
		end
		return true
	end
end

Guard.boolean = function(value: any): (boolean, string?)
	if type(value) ~= "boolean" then
		return false, "expected boolean"
	end
	return true
end :: Check

local GUID_PATTERN = "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"

-- Creature ids are GUIDs generated by HttpService:GenerateGUID(false).
Guard.creatureId = Guard.string(36, GUID_PATTERN)

-- Short identifiers (config ids): letters, digits and underscores.
Guard.identifier = Guard.string(32, "^[%w_]+$")

function Guard.oneOf(allowed: { [any]: any }): Check
	return function(value)
		if allowed[value] == nil then
			return false, "value not allowed"
		end
		return true
	end
end

function Guard.optional(check: Check): Check
	return function(value)
		if value == nil then
			return true
		end
		return check(value)
	end
end

-- A proper array (1..n, no holes, no extra keys) of values passing `check`.
function Guard.array(check: Check, maxLength: number): Check
	return function(value)
		if type(value) ~= "table" then
			return false, "expected array"
		end
		local count = 0
		for key in value do
			if type(key) ~= "number" or key % 1 ~= 0 or key < 1 then
				return false, "array has non-index keys"
			end
			count += 1
		end
		if count > maxLength then
			return false, "array too long"
		end
		for i = 1, count do
			if value[i] == nil then
				return false, "array has holes"
			end
			local ok, reason = check(value[i])
			if not ok then
				return false, "array item: " .. (reason or "invalid")
			end
		end
		return true
	end
end

-- Array whose values are unique.
function Guard.uniqueArray(check: Check, maxLength: number): Check
	local arrayCheck = Guard.array(check, maxLength)
	return function(value)
		local ok, reason = arrayCheck(value)
		if not ok then
			return false, reason
		end
		local seen = {}
		for _, item in value do
			if seen[item] then
				return false, "duplicate items"
			end
			seen[item] = true
		end
		return true
	end
end

-- Validates an argument list against a list of checks. Extra arguments are rejected.
function Guard.validateArgs(checks: { Check }, args: { any }, argCount: number): (boolean, string?)
	if argCount > #checks then
		return false, "too many arguments"
	end
	for index, check in checks do
		local ok, reason = check(args[index])
		if not ok then
			return false, string.format("arg %d: %s", index, reason or "invalid")
		end
	end
	return true
end

return table.freeze(Guard)
